# ─────────────────────────────────────────────────────────────────────────────
# EXZIBO — Environment Variables Reference
# Copy this file to .env and fill in real values. NEVER commit real values to Git.
# Add all required variables to your deployment platform (Vercel / Replit / Worker).
# ─────────────────────────────────────────────────────────────────────────────

# ── Neon PostgreSQL (REQUIRED — all runtimes) ───────────────────────────────
# Better Auth, orders, bookings, restaurants, analytics, and outbox all use this.
# Format: Neon/PostgreSQL connection string (includes sslmode)
DATABASE_URL=postgresql://your-database-url

# ── Better Auth (REQUIRED — Vercel/Express/Vite) ────────────────────────────
# Generate with: openssl rand -base64 32
# Must be at least 32 characters. Required in production/deployed environments.
BETTER_AUTH_SECRET=your_32_char_random_secret_here

# Primary domain that Google OAuth callback uses. Must match the Google Console
# Authorized redirect URI, e.g. https://superadmin.exzibo.online/api/auth/callback/google
BETTER_AUTH_BASE_URL=https://superadmin.exzibo.online

# Comma-separated list of additional origins allowed to make auth requests.
# Add Vercel preview URLs, custom domains, and subdomains here.
BETTER_AUTH_TRUSTED_ORIGINS=

# ── Google OAuth (REQUIRED — Vercel/Express/Vite production) ──────────────────
# Required in production. Optional in local dev (auth will not work without it).
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# ── Superadmin access (REQUIRED for superadmin panel) ─────────────────────────
# Comma-separated list of Google account emails allowed on the superadmin panel.
# Must match exactly what Google returns (lowercase, no quotes, no spaces).
SUPERADMIN_ALLOWED_EMAILS=your@gmail.com

# ── Upstash Redis (REQUIRED — production) ─────────────────────────────────────
# Rate limiting, duplicate prevention, and distributed locks.
# Required in production (VERCEL_ENV=production). Optional in dev/test.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ── Cloudflare R2 (REQUIRED — media mutation runtime) ─────────────────────────
# Required for image uploads in production. Optional in dev if media uploads are not used.
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
# Custom domain (e.g. https://images.exzibo.online) or legacy pub-xxx.r2.dev URL.
R2_PUBLIC_BASE_URL=https://images.exzibo.online
# Temporary compatibility alias; do not set it together with R2_PUBLIC_BASE_URL.
R2_PUBLIC_URL=

# ── Cloudflare Realtime (REQUIRED — publisher/ticket runtimes) ───────────────
# REALTIME_URL is the Worker endpoint (e.g. https://rt.exzibo.online).
# REALTIME_PUBLISH_SECRET is used by the backend to publish order events.
# REALTIME_TICKET_SECRET is used to sign WebSocket tickets.
# Generate both with: openssl rand -base64 32
REALTIME_URL=https://rt.exzibo.online
REALTIME_PUBLISH_SECRET=your_32_char_publish_secret_here
REALTIME_TICKET_SECRET=your_32_char_ticket_secret_here

# ── Trusted proxy / client IP resolution (OPTIONAL) ───────────────────────────
# TRUSTED_PROXY_MODE: direct (default), vercel, cloudflare, or trusted.
# TRUSTED_PROXY_HOPS: required when mode is 'trusted' (1-16).
TRUSTED_PROXY_MODE=direct
TRUSTED_PROXY_HOPS=

# ── Express runtime (OPTIONAL) ──────────────────────────────────────────────
PORT=5000

# ── Mobile app (OPTIONAL) ───────────────────────────────────────────────────
# Comma-separated custom-scheme origins for Expo / React Native clients.
# Example: MOBILE_APP_TRUSTED_ORIGINS=exzibo://,exp+exzibo://
MOBILE_APP_TRUSTED_ORIGINS=

# ── Dedicated preview login mode (OPTIONAL — never set in production) ────────
# Enables the preview login form instead of Google OAuth. Must be paired with
# PREVIEW_SECRET, PREVIEW_EMAIL, and PREVIEW_PASSWORD_HASH. PREVIEW_SECRET must
# be at least 32 characters. Never enable in production or general deployments.
APP_RUNTIME=
PREVIEW_SECRET=
PREVIEW_EMAIL=
PREVIEW_PASSWORD_HASH=

# ── Outbox consumer operational tuning (OPTIONAL) ───────────────────────────
OUTBOX_CONSUMER_ID=
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_LEASE_DURATION_SEC=30
OUTBOX_NETWORK_TIMEOUT_MS=10000
OUTBOX_HEARTBEAT_INTERVAL_SEC=15
OUTBOX_HEARTBEAT_MAX_AGE_SEC=60
OUTBOX_MAX_PENDING_AGE_SEC=300
OUTBOX_SHUTDOWN_TIMEOUT_SEC=30
OUTBOX_HEALTH_PORT=9090

# ── Operational / validation tooling (OPTIONAL) ───────────────────────────────
# These controls are used only by local diagnostics, performance checks,
# recovery rehearsals, release verification, and staging smoke tests.
LOG_LEVEL=info
DRY_RUN=true
RECOVERY_PROD_HOST_PATTERNS=
RECOVERY_ALLOW_NONPROD=false
PERFORMANCE_ALLOW_LOCAL=false
LOAD_TEST_TARGET=http://127.0.0.1:5000
LOAD_TEST_CONCURRENCY=1
LOAD_TEST_DURATION_MS=1000
LOAD_TEST_MAX_REQUESTS=100
LOAD_TEST_METHOD=GET
BUDGET_MEDIAN_MS=500
BUDGET_P95_MS=1000
BUDGET_ERROR_RATE=0.01
BENCHMARK_ITERATIONS=100
RELEASE_BUILD_RESULT=
RELEASE_TEST_SUMMARY=
STAGING_SMOKE_TARGET=
STAGING_SMOKE_ALLOW=false
STAGING_SMOKE_ORDER_BOOKING_FIXTURE=
RELEASE_VERIFY_SKIP_NODE=false
RELEASE_VERIFY_SKIP_WORKER=false
RELEASE_VERIFY_ACCEPTANCE_DB=false

# ── Client-side public variables (VITE_*) ────────────────────────────────────
# These are the ONLY variables that reach the browser. Never put secrets here.
# VITE_BETTER_AUTH_URL: public auth base URL (browser-side value; separate from
# the server-only BETTER_AUTH_BASE_URL).
# VITE_REALTIME_URL: public realtime Worker URL (defaults to rt.exzibo.online).
# VITE_R2_PUBLIC_BASE_URL: public image domain (defaults to https://images.exzibo.online).
# VITE_PREVIEW_MODE: set to 'true' to enable the preview login UI (dev only).
VITE_BETTER_AUTH_URL=
VITE_REALTIME_URL=
VITE_R2_PUBLIC_BASE_URL=
VITE_PREVIEW_MODE=

# ── OBSOLETE / REMOVED — do not use ───────────────────────────────────────────
# Supabase was replaced by Neon. Authentication-bypass variables were removed.
# Do not set any SUPABASE_* or authentication-bypass variables.
