{
  "name": "crimsonluxe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5000",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "db:migrate": "drizzle-kit migrate",
    "db:migration:check": "node scripts/validate-migrations.js",
    "db:migration:verify": "node scripts/validate-migrations.js",
    "validate:migrations": "node scripts/validate-migrations.js",
    "governance:check": "node scripts/governance-check.js",
    "check:serverless": "node scripts/check-serverless.js",
    "release:serverless": "node scripts/release/verifyServerlessBuild.js",
    "preflight": "node scripts/restaurant-preflight.js",
    "backfill:dry": "node scripts/restaurant-backfill.js",
    "backfill:apply": "node scripts/restaurant-backfill.js --apply",
    "check:outbox-lag": "node scripts/check-outbox-lag.js",
    "recovery:backup": "node scripts/createDatabaseBackup.js",
    "recovery:backup:dry": "DRY_RUN=true node scripts/createDatabaseBackup.js",
    "recovery:restore:verify": "node scripts/verifyDatabaseRestore.js",
    "recovery:reconcile:media": "node scripts/checkMediaReconciliation.js",
    "recovery:safety:check": "node -e \"import('./scripts/lib/recoverySafety.js').then(m => { const r = m.checkTarget(); console.log(r.safe ? 'SAFE: ' + r.safeLabel : 'BLOCKED: ' + r.reason); process.exit(r.safe ? 0 : 1) })\"",
    "test": "node --test tests/*.test.js api/__tests__/*.test.js 2>/dev/null || node --test tests/*.test.js api/__tests__/*.test.js",
    "test:monitoring": "node --test tests/monitoring.test.js api/__tests__/system.test.js",
    "outbox:consumer": "node scripts/runRealtimeOutboxConsumer.js",
    "outbox:consumer:once": "node scripts/runRealtimeOutboxConsumer.js --once",
    "outbox:consumer:check": "node scripts/runRealtimeOutboxConsumer.js --check",
    "perf:benchmark": "node scripts/performance/runServiceBenchmarks.js",
    "perf:loadtest": "PERFORMANCE_ALLOW_LOCAL=true node scripts/performance/runApiLoadTest.js",
    "perf:test": "node --test tests/performance-contract.test.js",
    "perf:check": "node scripts/performance/runServiceBenchmarks.js && node --test tests/performance-contract.test.js",
    "release:manifest": "node scripts/release/createReleaseManifest.js",
    "release:verify": "node scripts/release/verifyReleaseCandidate.js"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.23",
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "pg": "^8.20.0",
    "postcss": "^8.5.15",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-image-crop": "^11.0.10",
    "react-router-dom": "^7.14.2",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "vite": "^8.0.11"
  },
  "engines": {
    "node": "22.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
