{
  "headers": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "accelerometer=(), bluetooth=(), browsing-topics=(), camera=(), geolocation=(), gyroscope=(), interest-cohort=(), magnetometer=(), microphone=(), payment=(), serial=(), usb=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; img-src 'self' data: blob: https://images.exzibo.online https://images.unsplash.com https://i.pravatar.cc https://*.supabase.co; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://superadmin.exzibo.online https://dashboard.exzibo.online https://rt.exzibo.online wss://rt.exzibo.online; worker-src 'self' blob:; manifest-src 'self'; media-src 'self'; upgrade-insecure-requests; block-all-mixed-content" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/menu/categories/upsert",              "destination": "/api/menu-content?action=upsertCategory"                               },
    { "source": "/api/menu/categories/delete",              "destination": "/api/menu-content?action=deleteCategory"                               },
    { "source": "/api/menu/categories/:restaurantId",       "destination": "/api/menu-content?action=getCategories&restaurantId=:restaurantId"     },
    { "source": "/api/menu/items/upsert",                   "destination": "/api/menu-content?action=upsertItems"                                  },
    { "source": "/api/menu/items/:restaurantId/published",  "destination": "/api/menu-content?action=getPublishedItems&restaurantId=:restaurantId" },
    { "source": "/api/menu/items/:restaurantId",            "destination": "/api/menu-content?action=getItems&restaurantId=:restaurantId"          },
    { "source": "/api/menu/items",                          "destination": "/api/menu-content?action=createItem"                                   },
    { "source": "/api/menu/item-patch",                     "destination": "/api/menu-content?action=updateItem"                                   },
    { "source": "/api/menu/item-delete",                    "destination": "/api/menu-content?action=deleteItem"                                   },
    { "source": "/api/menu/upload-image",                   "destination": "/api/media?action=uploadMenuImage"                             },
    { "source": "/api/about/upload-image",                  "destination": "/api/media?action=uploadAboutImage"                            },
    { "source": "/api/about/save",                          "destination": "/api/menu-content?action=saveAbout"                                 },
    { "source": "/api/about/:restaurantId",                 "destination": "/api/menu-content?action=getAbout&restaurantId=:restaurantId"       },
    { "source": "/api/restaurant/upload-logo",              "destination": "/api/media?action=uploadLogoImage"                             },
    { "source": "/api/restaurant/upload-carousel",          "destination": "/api/media?action=uploadCarouselImage"                         },
    { "source": "/api/restaurant/update-social",            "destination": "/api/menu-content?action=updateSocial"                             },
    { "source": "/api/restaurant/update-profile",           "destination": "/api/restaurants?action=updateProfile"                        },
    { "source": "/api/orders/update-status",                "destination": "/api/orders?action=updateStatus"                              },
    { "source": "/api/orders/auto-cleanup",                 "destination": "/api/orders?action=autoCleanup"                               },
    { "source": "/api/orders/:restaurantId",                "destination": "/api/orders?restaurantId=:restaurantId"                       },
    { "source": "/api/mobile/v1/bootstrap",                 "destination": "/api/mobile/bootstrap"                                         },
    { "source": "/api/auth/:path*",                         "destination": "/api/auth?_path=:path*"                                        },
    { "source": "/api/neon/restaurants",                    "destination": "/api/restaurants?action=list"                                  },
    { "source": "/api/neon/restaurant/create",              "destination": "/api/restaurants?action=create"                                },
    { "source": "/api/neon/restaurant/by-slug/:slug",       "destination": "/api/restaurants?action=bySlug&slug=:slug"                    },
    { "source": "/api/neon/restaurant/by-uid/:uid",         "destination": "/api/restaurants?action=byUid&uid=:uid"                       },
    { "source": "/api/neon/restaurant/:id",                 "destination": "/api/restaurants?action=neonRestaurant&id=:id"                },
    { "source": "/api/restaurant/:id",                      "destination": "/api/restaurants?action=byId&id=:id"                          },
    { "source": "/api/analytics/:restaurantId",              "destination": "/api/restaurants?action=analytics&id=:restaurantId"            },
    { "source": "/api/neon/restaurant-settings/shadow-upsert", "destination": "/api/settings?action=setRestaurantSettings"                },
    { "source": "/api/bookings/:id/status",                 "destination": "/api/bookings?action=updateStatus&id=:id"                     },
    { "source": "/api/bookings/:restaurantId",              "destination": "/api/bookings?restaurantId=:restaurantId"                     },
    { "source": "/api/team-members/shadow-upsert",          "destination": "/api/team?action=shadowUpsert"                                },
    { "source": "/api/team-members/shadow-delete",          "destination": "/api/team?action=shadowDelete"                                },
    { "source": "/api/team-members/:restaurantId",          "destination": "/api/team?restaurantId=:restaurantId"                         },
    { "source": "/api/realtime/ticket",                    "destination": "/api/auth-check?action=issueTicket"                            },
    { "source": "/api/system",                              "destination": "/api/system"                                                    },
    { "source": "/api/restaurant-notifications",          "destination": "/api/notifications"                                             },
    { "source": "/api/(.*)",                                "destination": "/api/$1"                                                       },
    { "source": "/(.*)",                                    "destination": "/index.html"                                                   }
  ]
}
